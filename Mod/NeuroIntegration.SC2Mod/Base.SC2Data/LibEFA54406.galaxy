// Triggers
//--------------------------------------------------------------------------------------------------
// Trigger: Execute actions global
//--------------------------------------------------------------------------------------------------
bool libEFA54406_gt_Executeactionsglobal_Func (bool testConds, bool runActions) {
    // Automatic Variable Declarations
    string auto65C065F5_val;

    // Actions
    if (!runActions) {
        return true;
    }

    libEFA54406_gv_bankwriteallowed = false;
    BankLoad("NeuroIntegration", 1);
    BankWait(BankLastCreated());
    libEFA54406_gv_currentbankbackupid = BankValueGetAsInt(BankLastCreated(), "game_state", "backup_bank_id");
    if ((BankValueGetAsFlag(BankLastCreated(), "game_state", "startup_context") == true)) {
        BankValueSetFromFlag(BankLastCreated(), "game_state", "startup_context", false);
        TriggerSendEvent("startup_context");
    }

    if ((libEFA54406_gv_displayNameString != BankValueGetAsString(BankLastCreated(), "game_state", "display_name"))) {
        libEFA54406_gv_displayNameString = BankValueGetAsString(BankLastCreated(), "game_state", "display_name");
        auto65C065F5_val = libEFA54406_gv_displayNameString;
        if (auto65C065F5_val == "Neuro-sama") {
            libEFA54406_gv_displayNameText = StringExternal("Param/Value/lib_EFA54406_F8DDAFA8");
        }
        else if (auto65C065F5_val == "Evil Neuro") {
            libEFA54406_gv_displayNameText = StringExternal("Param/Value/lib_EFA54406_C3FAD57B");
        }
        else {
            libEFA54406_gv_displayNameText = StringToText(libEFA54406_gv_displayNameString);
            libEFA54406_gv_displayNameText = TextWithColor(libEFA54406_gv_displayNameText, Color(100.00, 50.20, 75.29));
        }
    }

    if ((BankValueGetAsFlag(BankLastCreated(), "do_action", "chat_message") == true)) {
        UIDisplayMessage(PlayerGroupAll(), c_messageAreaSubtitle, (libEFA54406_gv_displayNameText + StringToText(": ") + StringToText(BankValueGetAsString(BankLastCreated(), "do_action", "chat_message_arg_1"))));
        BankValueSetFromFlag(BankLastCreated(), "do_action", "chat_message", false);
    }

    BankSave(BankLastCreated());
    Wait(0.1, c_timeReal);
    TriggerSendEvent("execute_actions_map");
    return true;
}

