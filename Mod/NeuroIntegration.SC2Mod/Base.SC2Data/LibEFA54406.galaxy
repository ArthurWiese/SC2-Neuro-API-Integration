void libEFA54406_gt_InitLoad_Init () {
    libEFA54406_gt_InitLoad = TriggerCreate("libEFA54406_gt_InitLoad_Func");
    TriggerAddEventLoadGameDone(libEFA54406_gt_InitLoad);
}

